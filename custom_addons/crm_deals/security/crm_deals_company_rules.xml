<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_crm_deal_line_company" model="ir.rule">
        <field name="name">CRM Deal Lines: Allowed Companies</field>
        <field name="model_id" ref="model_crm_deal_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_crm_deal_commission_company" model="ir.rule">
        <field name="name">CRM Deal Commissions: Allowed Companies</field>
        <field name="model_id" ref="model_crm_deal_commission"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>