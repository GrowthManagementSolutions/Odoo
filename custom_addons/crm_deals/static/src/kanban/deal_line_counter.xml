<?xml version="1.0" encoding="utf-8"?>
<templates>

    <!-- Same markup and classes as project.SubtaskCounter, so the button reads
         as the same control on the card. -->
    <t t-name="crm_deals.DealLineCounter">
        <a t-att-title="counterTitle"
           class="deal_line_list_button btn-link text-dark"
           t-on-click.prevent="() => this.onClick()">
            <span class="fa fa-check-square-o me-1"/>
            <t t-esc="counterDisplay"/>
        </a>
    </t>

</templates>
