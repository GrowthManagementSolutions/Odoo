<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_deal_commission_view_list" model="ir.ui.view">
        <field name="name">crm.deal.commission.list</field>
        <field name="model">crm.deal.commission</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'received'"
                  decoration-danger="is_overdue"
                  decoration-muted="status == 'cancelled'">
                <field name="currency_id" column_invisible="1"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="deal_line_id"/>
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="payer_id"/>
                <field name="commission_type"/>
                <field name="due_date"/>
                <field name="expected_amount" sum="Total"/>
                <field name="received_amount" sum="Total"/>
                <field name="received_date"/>
                <field name="status"/>
                <button name="action_mark_received" type="object" icon="fa-check"
                        title="Mark as Received" invisible="status != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="crm_deal_commission_view_form" model="ir.ui.view">
        <field name="name">crm.deal.commission.form</field>
        <field name="model">crm.deal.commission</field>
        <field name="arch" type="xml">
            <form string="Commission">
                <header>
                    <button name="action_mark_received" type="object"
                            string="Mark as Received" class="btn-primary"
                            invisible="status != 'pending'"/>
                    <button name="action_mark_pending" type="object"
                            string="Mark as Pending" invisible="status != 'received'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,received,cancelled"/>
                </header>
                <sheet>
                    <field name="is_overdue" invisible="1"/>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="deal_line_id"/>
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="payer_id"/>
                        </group>
                        <group>
                            <field name="commission_type"/>
                            <field name="due_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="expected_amount"/>
                            <field name="received_amount"/>
                            <field name="received_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="crm_deal_commission_view_pivot" model="ir.ui.view">
        <field name="name">crm.deal.commission.pivot</field>
        <field name="model">crm.deal.commission</field>
        <field name="arch" type="xml">
            <pivot string="Commissions">
                <field name="due_date" interval="month" type="row"/>
                <field name="payer_id" type="col"/>
                <field name="expected_amount" type="measure"/>
                <field name="received_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="crm_deal_commission_view_graph" model="ir.ui.view">
        <field name="name">crm.deal.commission.graph</field>
        <field name="model">crm.deal.commission</field>
        <field name="arch" type="xml">
            <graph string="Commissions" type="bar">
                <field name="due_date" interval="month"/>
                <field name="expected_amount" type="measure"/>
                <field name="received_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="crm_deal_commission_view_search" model="ir.ui.view">
        <field name="name">crm.deal.commission.search</field>
        <field name="model">crm.deal.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="deal_line_id"/>
                <field name="deal_line_id" string="Deal ID"
                       filter_domain="[('deal_line_id.deal_ref', 'ilike', self)]"/>
                <field name="product_id"/>
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="payer_id"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('status', '=', 'pending')]"/>
                <filter name="filter_received" string="Received"
                        domain="[('status', '=', 'received')]"/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="filter_cancelled" string="Cancelled"
                        domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_due_this_month" string="Due this month"
                        domain="[('due_date', '&gt;=', (context_today()).strftime('%Y-%m-01')),
                                 ('due_date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <filter name="filter_due_90" string="Due next 90 days"
                        domain="[('due_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('due_date', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_by_deal" string="Deal"
                            context="{'group_by': 'deal_line_id'}"/>
                    <filter name="group_by_lead" string="Opportunity"
                            context="{'group_by': 'lead_id'}"/>
                    <filter name="group_by_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_payer" string="Payer"
                            context="{'group_by': 'payer_id'}"/>
                    <filter name="group_by_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_type" string="Type"
                            context="{'group_by': 'commission_type'}"/>
                    <filter name="group_by_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_by_due" string="Due Date"
                            context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="crm_deal_commission_action" model="ir.actions.act_window">
        <field name="name">Commissions Forecast</field>
        <field name="res_model">crm.deal.commission</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'group_by': 'deal_line_id'}</field>
    </record>

    <!-- Reporting's own entries run sequence 1-4, so this lands last.
         The same menuitem record is re-parented, so the old top-level
         location disappears rather than being left behind. -->
    <menuitem id="crm_deal_commission_menu"
              name="Commissions Forecast"
              parent="crm.crm_menu_report"
              action="crm_deal_commission_action"
              sequence="5"/>
</odoo>
