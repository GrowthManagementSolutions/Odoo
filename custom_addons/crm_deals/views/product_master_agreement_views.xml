<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_master_agreement_view_list" model="ir.ui.view">
        <field name="name">product.master.agreement.list</field>
        <field name="model">product.master.agreement</field>
        <field name="arch" type="xml">
            <list string="Master Agreements">
                <field name="master_id"/>
                <field name="gms_share" widget="percentage"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>

    <record id="product_master_agreement_view_form" model="ir.ui.view">
        <field name="name">product.master.agreement.form</field>
        <field name="model">product.master.agreement</field>
        <field name="arch" type="xml">
            <form string="Master Agreement">
                <sheet>
                    <group>
                        <group>
                            <field name="master_id"
                                   options="{'no_create': True}"/>
                            <field name="gms_share" widget="percentage"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_master_agreement_view_search" model="ir.ui.view">
        <field name="name">product.master.agreement.search</field>
        <field name="model">product.master.agreement</field>
        <field name="arch" type="xml">
            <search>
                <field name="master_id"/>
                <filter name="effective" string="Effective Today"
                        domain="[('date_from', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 '|', ('date_to', '=', False),
                                 ('date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_master" string="Master Supplier"
                            context="{'group_by': 'master_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="product_master_agreement_action" model="ir.actions.act_window">
        <field name="name">Master Agreements</field>
        <field name="res_model">product.master.agreement</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="product_master_agreement_menu"
              name="Master Agreements"
              action="product_master_agreement_action"
              parent="crm.crm_menu_config"
              sequence="17"/>
</odoo>
