<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_subsector_view_list" model="ir.ui.view">
        <field name="name">res.partner.subsector.list</field>
        <field name="model">res.partner.subsector</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="industry_id"/>
            </list>
        </field>
    </record>

    <record id="res_partner_subsector_view_form" model="ir.ui.view">
        <field name="name">res.partner.subsector.form</field>
        <field name="model">res.partner.subsector</field>
        <field name="arch" type="xml">
            <form string="Sub-sector">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="industry_id"/>
                        <field name="default_technology_ids"
                               widget="many2many_tags"
                               options="{'color_field': 'color'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_subsector_action" model="ir.actions.act_window">
        <field name="name">Sub-sectors</field>
        <field name="res_model">res.partner.subsector</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="res_partner_subsector_menu"
              name="Sub-sectors"
              action="res_partner_subsector_action"
              parent="contacts.res_partner_menu_config"
              sequence="2"/>
</odoo>
