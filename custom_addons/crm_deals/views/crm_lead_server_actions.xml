<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_accept_all_deals" model="ir.actions.server">
        <field name="name">Accept All Deals</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_accept_all_deals()</field>
    </record>

    <record id="action_reject_all_deals" model="ir.actions.server">
        <field name="name">Reject All Deals</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_reject_all_deals()</field>
    </record>

    <record id="action_send_budget_summary" model="ir.actions.server">
        <field name="name">Send Budget Summary</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_budget_summary()</field>
    </record>
</odoo>
