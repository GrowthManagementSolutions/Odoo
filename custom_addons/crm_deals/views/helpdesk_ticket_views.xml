<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_config_document" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.config.document</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_add_config_document" type="object"
                        string="Add Configuration Document"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_config_documents" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="config_document_count == 0">
                    <field name="config_document_count" widget="statinfo"
                           string="Config Documents"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
