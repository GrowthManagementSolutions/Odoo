<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- #59 Part B: a worked Med Spa example on top of the #53 demo set.
             Every supplier contact, master agreement, product and tag used
             here is already seeded elsewhere and is only referenced.
             Rates are fractions: 0.24 renders as 24%. No rule carries a
             date, so each one is effective forever (key rule 42). -->

        <!-- ===== Sub-sector ===== -->
        <record id="subsector_medical_clinic_med_spa" model="res.partner.subsector">
            <field name="name">Med Spa &amp; Aesthetics</field>
            <field name="industry_id" ref="industry_medical_clinic"/>
        </record>

        <!-- ===== Routes ===== -->
        <record id="route_ringcentral_telarus" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_ringcentral"/>
            <field name="master_id" ref="partner_master_supplier_telarus"/>
        </record>
        <record id="route_verizon_telarus" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_verizon"/>
            <field name="master_id" ref="partner_master_supplier_telarus"/>
        </record>
        <record id="route_ooma_direct" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_ooma"/>
        </record>
        <record id="route_comcast_sandler" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_comcast"/>
            <field name="master_id" ref="partner_master_supplier_sandler_partners"/>
        </record>
        <record id="route_spectrum_telarus" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_spectrum"/>
            <field name="master_id" ref="partner_master_supplier_telarus"/>
        </record>
        <record id="route_cyber_advisors_direct" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_cyber_advisors"/>
        </record>
        <record id="route_integrated_computer_services_sandler"
                model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_integrated_computer_services"/>
            <field name="master_id" ref="partner_master_supplier_sandler_partners"/>
        </record>
        <record id="route_cardconnect_sandler" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_cardconnect"/>
            <field name="master_id" ref="partner_master_supplier_sandler_partners"/>
        </record>
        <record id="route_rectangle_health_telarus" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_rectangle_health"/>
            <field name="master_id" ref="partner_master_supplier_telarus"/>
        </record>
        <record id="route_dejavoo_sandler" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_dejavoo"/>
            <field name="master_id" ref="partner_master_supplier_sandler_partners"/>
        </record>
        <record id="route_clover_direct" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_clover"/>
        </record>
        <record id="route_daysmart_direct" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_daysmart"/>
        </record>
        <record id="route_aspire_software_telarus" model="product.supplier.route">
            <field name="supplier_id" ref="partner_supplier_aspire_software"/>
            <field name="master_id" ref="partner_master_supplier_telarus"/>
        </record>

        <!-- ===== Route product rules ===== -->
        <!-- UCaaS -->
        <record id="rule_ringcentral_telarus_ucaas" model="product.route.rule">
            <field name="route_id" ref="route_ringcentral_telarus"/>
            <field name="product_tmpl_id" ref="product_telecommunications_ucaas"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.24</field>
            <field name="spiff_multiplier">6</field>
            <field name="is_default" eval="True"/>
        </record>

        <!-- Wireless POTS Replacement -->
        <record id="rule_verizon_telarus_wireless_pots" model="product.route.rule">
            <field name="route_id" ref="route_verizon_telarus"/>
            <field name="product_tmpl_id"
                   ref="product_telecommunications_wireless_pots_replacement"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.20</field>
            <field name="spiff_multiplier">2</field>
            <field name="is_default" eval="True"/>
        </record>
        <record id="rule_ooma_direct_wireless_pots" model="product.route.rule">
            <field name="route_id" ref="route_ooma_direct"/>
            <field name="product_tmpl_id"
                   ref="product_telecommunications_wireless_pots_replacement"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.18</field>
            <field name="spiff_multiplier">1</field>
            <field name="is_default" eval="True"/>
        </record>

        <!-- Best Effort Internet -->
        <record id="rule_comcast_sandler_best_effort_internet" model="product.route.rule">
            <field name="route_id" ref="route_comcast_sandler"/>
            <field name="product_tmpl_id"
                   ref="product_internet_service_best_effort_internet"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.15</field>
            <field name="spiff_multiplier">1</field>
            <field name="is_default" eval="True"/>
        </record>
        <record id="rule_spectrum_telarus_best_effort_internet" model="product.route.rule">
            <field name="route_id" ref="route_spectrum_telarus"/>
            <field name="product_tmpl_id"
                   ref="product_internet_service_best_effort_internet"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.16</field>
            <field name="spiff_multiplier">1</field>
            <field name="is_default" eval="True"/>
        </record>

        <!-- Managed Network Security -->
        <record id="rule_cyber_advisors_direct_managed_network_security"
                model="product.route.rule">
            <field name="route_id" ref="route_cyber_advisors_direct"/>
            <field name="product_tmpl_id"
                   ref="product_cybersecurity_managed_network_security"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.20</field>
            <field name="spiff_multiplier">0</field>
            <field name="nrc_margin_type">percent</field>
            <field name="nrc_margin_value">0.10</field>
            <field name="is_default" eval="True"/>
        </record>
        <record id="rule_integrated_computer_services_sandler_managed_network_security"
                model="product.route.rule">
            <field name="route_id" ref="route_integrated_computer_services_sandler"/>
            <field name="product_tmpl_id"
                   ref="product_cybersecurity_managed_network_security"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.18</field>
            <field name="spiff_multiplier">1</field>
            <field name="is_default" eval="True"/>
        </record>

        <!-- Payment Processing -->
        <record id="rule_cardconnect_sandler_payment_processing" model="product.route.rule">
            <field name="route_id" ref="route_cardconnect_sandler"/>
            <field name="product_tmpl_id"
                   ref="product_payment_processing_solutions_payment_processing"/>
            <field name="recurring_basis">volume</field>
            <field name="residual_rate">0.0075</field>
            <field name="spiff_multiplier">0</field>
            <field name="is_default" eval="True"/>
        </record>
        <record id="rule_rectangle_health_telarus_payment_processing"
                model="product.route.rule">
            <field name="route_id" ref="route_rectangle_health_telarus"/>
            <field name="product_tmpl_id"
                   ref="product_payment_processing_solutions_payment_processing"/>
            <field name="recurring_basis">volume</field>
            <field name="residual_rate">0.0060</field>
            <field name="spiff_multiplier">0</field>
            <field name="is_default" eval="True"/>
        </record>

        <!-- Standalone CC Terminal -->
        <record id="rule_dejavoo_sandler_standalone_cc_terminal" model="product.route.rule">
            <field name="route_id" ref="route_dejavoo_sandler"/>
            <field name="product_tmpl_id"
                   ref="product_point_of_sale_standalone_cc_terminal"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.20</field>
            <field name="spiff_eligible" eval="False"/>
            <field name="spiff_multiplier">0</field>
            <field name="nrc_margin_type">fixed</field>
            <field name="nrc_margin_value">150</field>
            <field name="is_default" eval="True"/>
        </record>
        <record id="rule_clover_direct_standalone_cc_terminal" model="product.route.rule">
            <field name="route_id" ref="route_clover_direct"/>
            <field name="product_tmpl_id"
                   ref="product_point_of_sale_standalone_cc_terminal"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.15</field>
            <field name="spiff_multiplier">0</field>
            <field name="nrc_margin_type">percent</field>
            <field name="nrc_margin_value">0.20</field>
            <field name="is_default" eval="True"/>
        </record>

        <!-- Health &amp; Beauty Software -->
        <record id="rule_daysmart_direct_health_and_beauty" model="product.route.rule">
            <field name="route_id" ref="route_daysmart_direct"/>
            <field name="product_tmpl_id"
                   ref="product_practice_management_software_health_and_beauty"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.25</field>
            <field name="spiff_multiplier">2</field>
            <field name="nrc_margin_type">percent</field>
            <field name="nrc_margin_value">0.15</field>
            <field name="is_default" eval="True"/>
        </record>
        <record id="rule_aspire_software_telarus_health_and_beauty" model="product.route.rule">
            <field name="route_id" ref="route_aspire_software_telarus"/>
            <field name="product_tmpl_id"
                   ref="product_practice_management_software_health_and_beauty"/>
            <field name="recurring_basis">mrc</field>
            <field name="residual_rate">0.20</field>
            <field name="spiff_multiplier">1</field>
            <field name="is_default" eval="True"/>
        </record>

        <!-- ===== Deal templates ===== -->
        <record id="deal_template_med_spa_communications" model="crm.deal.template">
            <field name="name">Med Spa – Communications &amp; Network</field>
            <field name="industry_id" ref="industry_medical_clinic"/>
            <field name="subsector_id" ref="subsector_medical_clinic_med_spa"/>
            <field name="sequence">10</field>
            <field name="budget_note" type="html">
                <p>All figures are estimates based on current supplier pricing and the information provided. Monthly charges begin when each service is installed. One-time charges cover equipment and installation. Each service is provided under its own supplier agreement, which you will receive separately for signature. This budget summary is valid for 30 days.</p>
            </field>
        </record>
        <record id="deal_template_line_med_spa_comms_section_phones"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_communications"/>
            <field name="sequence">10</field>
            <field name="display_type">line_section</field>
            <field name="name">Phones</field>
        </record>
        <record id="deal_template_line_med_spa_comms_ucaas"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_communications"/>
            <field name="sequence">20</field>
            <field name="product_id" model="product.product"
                   search="[('product_tmpl_id', '=', ref('crm_deals.product_telecommunications_ucaas'))]"/>
            <field name="supplier_id" ref="partner_supplier_ringcentral"/>
            <field name="route_id" ref="route_ringcentral_telarus"/>
            <field name="contract_term">36</field>
            <field name="quantity">8</field>
            <field name="unit_price">28</field>
            <field name="estimated_one_time_revenue">0</field>
        </record>
        <record id="deal_template_line_med_spa_comms_pots"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_communications"/>
            <field name="sequence">30</field>
            <field name="product_id" model="product.product"
                   search="[('product_tmpl_id', '=', ref('crm_deals.product_telecommunications_wireless_pots_replacement'))]"/>
            <field name="supplier_id" ref="partner_supplier_ooma"/>
            <field name="route_id" ref="route_ooma_direct"/>
            <field name="contract_term">36</field>
            <field name="quantity">2</field>
            <field name="unit_price">40</field>
            <field name="estimated_one_time_revenue">150</field>
        </record>
        <record id="deal_template_line_med_spa_comms_section_internet"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_communications"/>
            <field name="sequence">40</field>
            <field name="display_type">line_section</field>
            <field name="name">Internet &amp; Security</field>
        </record>
        <record id="deal_template_line_med_spa_comms_internet"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_communications"/>
            <field name="sequence">50</field>
            <field name="product_id" model="product.product"
                   search="[('product_tmpl_id', '=', ref('crm_deals.product_internet_service_best_effort_internet'))]"/>
            <field name="supplier_id" ref="partner_supplier_comcast"/>
            <field name="route_id" ref="route_comcast_sandler"/>
            <field name="contract_term">36</field>
            <field name="quantity">1</field>
            <field name="unit_price">189</field>
            <field name="estimated_one_time_revenue">250</field>
        </record>
        <record id="deal_template_line_med_spa_comms_security"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_communications"/>
            <field name="sequence">60</field>
            <field name="product_id" model="product.product"
                   search="[('product_tmpl_id', '=', ref('crm_deals.product_cybersecurity_managed_network_security'))]"/>
            <field name="supplier_id" ref="partner_supplier_cyber_advisors"/>
            <field name="route_id" ref="route_cyber_advisors_direct"/>
            <field name="contract_term">36</field>
            <field name="quantity">1</field>
            <field name="unit_price">350</field>
            <field name="estimated_one_time_revenue">1200</field>
        </record>

        <record id="deal_template_med_spa_front_desk" model="crm.deal.template">
            <field name="name">Med Spa – Front Desk &amp; Payments</field>
            <field name="industry_id" ref="industry_medical_clinic"/>
            <field name="subsector_id" ref="subsector_medical_clinic_med_spa"/>
            <field name="sequence">20</field>
            <field name="budget_note" type="html">
                <p>All figures are estimates based on current supplier pricing and the information provided. Monthly charges begin when each service is installed. One-time charges cover equipment and installation. Each service is provided under its own supplier agreement, which you will receive separately for signature. This budget summary is valid for 30 days.</p>
            </field>
        </record>
        <record id="deal_template_line_med_spa_front_section_payments"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_front_desk"/>
            <field name="sequence">10</field>
            <field name="display_type">line_section</field>
            <field name="name">Payments</field>
        </record>
        <record id="deal_template_line_med_spa_front_payment_processing"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_front_desk"/>
            <field name="sequence">20</field>
            <field name="product_id" model="product.product"
                   search="[('product_tmpl_id', '=', ref('crm_deals.product_payment_processing_solutions_payment_processing'))]"/>
            <field name="supplier_id" ref="partner_supplier_cardconnect"/>
            <field name="route_id" ref="route_cardconnect_sandler"/>
            <field name="contract_term">month_to_month</field>
            <field name="quantity">1</field>
            <field name="unit_price">0</field>
            <field name="processing_volume">85000</field>
            <field name="estimated_one_time_revenue">0</field>
        </record>
        <record id="deal_template_line_med_spa_front_terminal"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_front_desk"/>
            <field name="sequence">30</field>
            <field name="product_id" model="product.product"
                   search="[('product_tmpl_id', '=', ref('crm_deals.product_point_of_sale_standalone_cc_terminal'))]"/>
            <field name="supplier_id" ref="partner_supplier_dejavoo"/>
            <field name="route_id" ref="route_dejavoo_sandler"/>
            <field name="contract_term">36</field>
            <field name="quantity">3</field>
            <field name="unit_price">20</field>
            <field name="estimated_one_time_revenue">900</field>
        </record>
        <record id="deal_template_line_med_spa_front_section_software"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_front_desk"/>
            <field name="sequence">40</field>
            <field name="display_type">line_section</field>
            <field name="name">Practice Software</field>
        </record>
        <record id="deal_template_line_med_spa_front_software"
                model="crm.deal.template.line">
            <field name="template_id" ref="deal_template_med_spa_front_desk"/>
            <field name="sequence">50</field>
            <field name="product_id" model="product.product"
                   search="[('product_tmpl_id', '=', ref('crm_deals.product_practice_management_software_health_and_beauty'))]"/>
            <field name="supplier_id" ref="partner_supplier_daysmart"/>
            <field name="route_id" ref="route_daysmart_direct"/>
            <field name="contract_term">12</field>
            <field name="quantity">1</field>
            <field name="unit_price">299</field>
            <field name="estimated_one_time_revenue">500</field>
        </record>

    </data>
</odoo>
