<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         GMS CRM APPLICATION CATEGORY
         ====================================================== -->

    <record id="module_category_gms_crm"
            model="ir.module.category">
        <field name="name">GMS CRM</field>
        <field name="description">
            Growth Management Solutions CRM roles
        </field>
        <field name="sequence">30</field>
    </record>

    <!--
        Odoo 19 uses res.groups.privilege.
        category_id belongs on the privilege, not res.groups.
    -->

    <record id="privilege_gms_crm_access"
            model="res.groups.privilege">
        <field name="name">GMS CRM Access</field>
        <field name="description">
            Access level for the GMS CRM workflow
        </field>
        <field name="category_id"
               ref="module_category_gms_crm"/>
        <field name="sequence">10</field>
    </record>

    <!-- ======================================================
         GMS CRM SECURITY GROUPS
         ====================================================== -->

    <record id="group_gms_crm_user"
            model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id"
               ref="privilege_gms_crm_access"/>
        <field name="sequence">10</field>
        <field name="implied_ids"
               eval="[
                   (4, ref('sales_team.group_sale_salesman'))
               ]"/>
    </record>

    <record id="group_gms_solution_architect"
            model="res.groups">
        <field name="name">Solution Architect</field>
        <field name="privilege_id"
               ref="privilege_gms_crm_access"/>
        <field name="sequence">20</field>
        <field name="implied_ids"
               eval="[
                   (4, ref('group_gms_crm_user'))
               ]"/>
    </record>

    <record id="group_gms_channel_manager"
            model="res.groups">
        <field name="name">Channel Manager</field>
        <field name="privilege_id"
               ref="privilege_gms_crm_access"/>
        <field name="sequence">30</field>
        <field name="implied_ids"
               eval="[
                   (4, ref('group_gms_crm_user'))
               ]"/>
    </record>

    <record id="group_gms_sales_manager"
            model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="privilege_id"
               ref="privilege_gms_crm_access"/>
        <field name="sequence">40</field>
        <field name="implied_ids"
               eval="[
                   (4, ref('group_gms_crm_user')),
                   (4, ref('sales_team.group_sale_manager'))
               ]"/>
    </record>

    <record id="group_gms_crm_admin"
            model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id"
               ref="privilege_gms_crm_access"/>
        <field name="sequence">50</field>
        <field name="implied_ids"
               eval="[
                   (4, ref('group_gms_sales_manager'))
               ]"/>
    </record>

    <!-- ======================================================
         SALES-TEAM DEAL SHARING
         ====================================================== -->

    <!--
        Users with a GMS CRM role can read and edit opportunities
        assigned to a sales team of which they are a member.

        This is combined with Odoo's standard "Own Documents Only"
        rule, so users retain access to their own deals and gain
        access to deals belonging to their shared sales teams.
    -->

    <record id="rule_gms_crm_team_deal_access"
            model="ir.rule">

        <field name="name">
            GMS CRM: Access deals from my sales teams
        </field>

        <field name="model_id"
               ref="crm.model_crm_lead"/>

        <field name="domain_force">
            [('team_id.member_ids', 'in', [user.id])]
        </field>

        <field name="groups"
               eval="[
                   (4, ref('group_gms_crm_user'))
               ]"/>

        <!-- The rule applies only when reading or editing records -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>

    </record>

</odoo>