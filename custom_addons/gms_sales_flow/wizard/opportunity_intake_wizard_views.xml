<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gms_opportunity_intake_wizard_form"
            model="ir.ui.view">
        <field name="name">gms.opportunity.intake.wizard.form</field>
        <field name="model">gms.opportunity.intake.wizard</field>
        <field name="arch" type="xml">
            <form string="New Opportunity">
                <sheet>
                    <group>
                        <group string="Company">
                            <field name="company_name"/>
                            
                        </group>

                        <group string="Contact">
                            <field name="contact_name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="salesperson_id"/>
                        </group>
                    </group>

                    <group string="Address">
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                        </group>

                        <group>
                            <field name="country_id"/>
                            <field name="state_id"
                                   domain="[('country_id', '=', country_id)]"/>
                            <field name="zip"/>
                        </group>
                    </group>

                    <group string="Channel">
                        <field name="channel_involved"/>

                        <field name="has_referral_partner"
                               invisible="channel_involved"/>

                        <field name="referral_partner_id"
                               invisible="channel_involved or not has_referral_partner"
                               required="not channel_involved and has_referral_partner"/>

                        <field name="independent_agent_id"
                               invisible="not channel_involved"
                               required="channel_involved"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_create_opportunity"
                            type="object"
                            string="Create Opportunity"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gms_opportunity_intake_wizard"
            model="ir.actions.act_window">
        <field name="name">New Opportunity</field>
        <field name="res_model">gms.opportunity.intake.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="view_gms_opportunity_intake_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>