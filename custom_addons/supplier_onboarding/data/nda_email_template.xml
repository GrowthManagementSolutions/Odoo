<odoo>
    <record id="email_template_supplier_nda" model="mail.template">
        <field name="name">Supplier NDA Email</field>
        <field name="model_id" ref="model_supplier_onboarding"/>
        <field name="subject">Mutual NDA for Supplier Onboarding</field>
        <field name="email_to">{{ object.contact_email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.contact_name"/>,</p>

                <p>
                    Thank you for submitting your supplier onboarding information.
                    As the next step, please review and complete the mutual non-disclosure agreement.
                </p>

                <p>
                    <strong>Supplier:</strong>
                    <t t-out="object.legal_business_name"/>
                </p>

                <p>
                    We will follow up once the NDA is completed.
                </p>

                <p>
                    Thank you,<br/>
                    Supplier Onboarding Team
                </p>
            </div>
        </field>
    </record>
</odoo>