<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_supplier_onboarding" model="ir.actions.act_window">
        <field name="name">Supplier Onboarding</field>
        <field name="res_model">supplier.onboarding</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_supplier_onboarding_root"
              name="Supplier Onboarding"
              sequence="90"
              groups="base.group_no_one"/>

    <menuitem id="menu_supplier_onboarding_records"
              name="Suppliers"
              parent="menu_supplier_onboarding_root"
              action="action_supplier_onboarding"
              sequence="10"/>

    <record id="view_supplier_onboarding_list" model="ir.ui.view">
        <field name="name">supplier.onboarding.list</field>
        <field name="model">supplier.onboarding</field>
        <field name="arch" type="xml">
            <list>
                <field name="legal_business_name"/>
                <field name="dba_name"/>
                <field name="contact_name"/>
                <field name="contact_email"/>
                <field name="website"/>
                <field name="channel_manager_id"/>
                <field name="nda_sent"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_onboarding_form" model="ir.ui.view">
        <field name="name">supplier.onboarding.form</field>
        <field name="model">supplier.onboarding</field>
        <field name="arch" type="xml">
            <form string="Supplier Onboarding">
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_send_nda"
                            type="object"
                            string="Send NDA"
                            class="btn-primary"
                            invisible="state not in ('submitted', 'draft')"/>

                    <button name="action_approve"
                            type="object"
                            string="Approve Supplier"
                            class="btn-success"
                            invisible="state not in ('submitted', 'nda_sent')"/>

                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            invisible="state in ('approved', 'rejected')"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,nda_sent,approved,rejected"/>
                </header>

                <sheet>
                    <group>
                        <group string="Business Information">
                            <field name="legal_business_name"/>
                            <field name="dba_name"/>
                            <field name="website"/>
                            <field name="product_services_offered"/>
                            <field name="supplier_partner_id" readonly="1"/>
                        </group>

                        <group string="Channel Manager / Internal Owner">
                            <field name="channel_manager_id"/>
                            <field name="channel_manager_email"/>
                            <field name="channel_manager_phone"/>
                        </group>
                    </group>

                    <group string="Address">
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                        </group>
                    </group>

                    <group string="Primary Contact">
                        <group>
                            <field name="contact_name"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                        </group>
                    </group>

                    <group string="Documents">
                        <field name="supplier_contract"
                               filename="supplier_contract_filename"/>
                        <field name="supplier_contract_filename" invisible="1"/>
                    </group>

                    <group string="NDA">
                        <field name="nda_sent" readonly="1"/>
                        <field name="nda_sent_date" readonly="1"/>
                    </group>

                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

</odoo>