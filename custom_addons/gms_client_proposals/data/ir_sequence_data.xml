<odoo>
    <record id="seq_gms_client_proposal" model="ir.sequence">
        <field name="name">GMS Client Proposal</field>
        <field name="code">gms.client.proposal</field>
        <field name="prefix">PROP/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_gms_recipient_statement" model="ir.sequence">
        <field name="name">Recipient Statement</field>
        <field name="code">gms.recipient.statement</field>
        <field name="prefix">STM/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>


