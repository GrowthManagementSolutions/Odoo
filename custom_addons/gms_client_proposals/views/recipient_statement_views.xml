<odoo>

    <!-- ACTION -->

    <record id="action_gms_recipient_statements" model="ir.actions.act_window">
        <field name="name">Recipient Statements</field>
        <field name="res_model">gms.recipient.statement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- LIST VIEW -->

    <record id="view_gms_recipient_statement_list" model="ir.ui.view">
        <field name="name">gms.recipient.statement.list</field>
        <field name="model">gms.recipient.statement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="recipient_id"/>
                <field name="statement_month"/>
                <field name="total_earnings"/>
                <field name="total_adjustments"/>
                <field name="net_payout"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->

    <record id="view_gms_recipient_statement_form" model="ir.ui.view">
        <field name="name">gms.recipient.statement.form</field>
        <field name="model">gms.recipient.statement</field>
        <field name="arch" type="xml">
            <form string="Recipient Statement">

                <header>

                    <button name="action_finalize"
                            type="object"
                            string="Finalize"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_mark_sent"
                            type="object"
                            string="Mark Sent"
                            class="btn-success"
                            invisible="state != 'finalized'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,finalized,sent"/>

                </header>

                <sheet>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="recipient_id"/>
                            <field name="payout_batch_id"/>
                        </group>

                        <group>
                            <field name="statement_month"/>
                            <field name="total_earnings" readonly="1"/>
                            <field name="total_adjustments" readonly="1"/>
                            <field name="net_payout" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Statement Lines">

                            <field name="line_ids">

                                <list editable="bottom">

                                    <field name="merchant_id"/>
                                    <field name="service_id"/>
                                    <field name="gross_amount"/>
                                    <field name="commission_rate"/>
                                    <field name="earning_amount"/>
                                    <field name="adjustment_amount"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

</odoo>