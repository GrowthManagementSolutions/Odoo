<odoo>
    <record id="view_gms_rate_table_list" model="ir.ui.view">
        <field name="name">gms.proposal.rate.table.list</field>
        <field name="model">gms.proposal.rate.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="effective_start"/>
                <field name="effective_end"/>
                <field name="minimum_monthly_fee"/>
                <field name="minimum_one_time_fee"/>
            </list>
        </field>
    </record>

    <record id="view_gms_rate_table_form" model="ir.ui.view">
        <field name="name">gms.proposal.rate.table.form</field>
        <field name="model">gms.proposal.rate.table</field>
        <field name="arch" type="xml">
            <form string="Rate Table">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="supplier_id"/>
                            <field name="effective_start"/>
                            <field name="effective_end"/>
                        </group>
                        <group>
                            <field name="default_contract_term_months"/>
                            <field name="minimum_contract_term_months"/>
                            <field name="maximum_contract_term_months"/>
                        </group>
                    </group>

                    <group string="Recurring Fees">
                        <field name="minimum_monthly_fee"/>
                        <field name="target_monthly_fee"/>
                        <field name="maximum_monthly_fee"/>
                    </group>

                    <group string="One-Time Fees">
                        <field name="minimum_one_time_fee"/>
                        <field name="target_one_time_fee"/>
                        <field name="maximum_one_time_fee"/>
                    </group>

                    <group string="Approval Thresholds">
                        <field name="approval_required_below_monthly"/>
                        <field name="approval_required_below_one_time"/>
                        <field name="approval_required_below_term"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gms_rate_table" model="ir.actions.act_window">
        <field name="name">Rate Tables</field>
        <field name="res_model">gms.proposal.rate.table</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gms_rate_table"
              name="Rate Tables"
              parent="menu_gms_config"
              action="action_gms_rate_table"/>
</odoo>