<odoo>
    <record id="view_res_partner_form_gms" model="ir.ui.view">
        <field name="name">res.partner.form.gms</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Top smart button beside Opportunities, Sales, Invoiced, etc. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_gms_deals"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-handshake-o">
                    <field name="gms_deal_count"
                           widget="statinfo"
                           string="Deals"/>
                </button>
            </xpath>

            <!-- GMS tab -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="GMS">
                    <group>
                        <group>
                            <field name="x_gms_partner_type"/>
                            <field name="x_gms_is_client"/>
                            <field name="x_gms_is_supplier"/>
                            <field name="x_gms_is_commission_recipient"/>
                            <field name="x_gms_active_for_proposals"/>
                        </group>

                        <group>
                            <field name="x_gms_primary_rep_id"/>
                            <field name="x_gms_support_manager_id"/>
                            <field name="x_gms_channel_manager_id"/>
                        </group>
                    </group>

                    <group string="Actions">
                        <button name="action_create_gms_opportunity"
                                type="object"
                                string="Create Opportunity"
                                class="btn-primary"/>

                        <button name="action_create_gms_proposal"
                                type="object"
                                string="Create Proposal"
                                class="btn-secondary"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>