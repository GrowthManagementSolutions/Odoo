<odoo>
    <record id="view_crm_lead_form_gms_proposal" model="ir.ui.view">
        <field name="name">crm.lead.form.gms.proposal</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="GMS Proposal">
                    <group>
                        <field name="x_gms_primary_solution_category_id"/>
                        <field name="x_gms_expected_monthly_volume"/>
                        <field name="x_gms_expected_contract_term"/>
                        <field name="x_gms_primary_rep_id"/>
                        <field name="x_gms_support_manager_id"/>
                        <field name="x_gms_channel_manager_id"/>
                        <field name="x_gms_latest_proposal_id" readonly="1"/>
                    </group>

                    <field name="gms_proposal_ids">
                        <list>
                            <field name="name"/>
                            <field name="revision_number"/>
                            <field name="state"/>
                            <field name="proposal_date"/>
                            <field name="valid_until"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>