<odoo>
    <record id="view_gms_sow_template_list" model="ir.ui.view">
        <field name="name">gms.sow.template.list</field>
        <field name="model">gms.sow.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_gms_sow_template_form" model="ir.ui.view">
        <field name="name">gms.sow.template.form</field>
        <field name="model">gms.sow.template</field>
        <field name="arch" type="xml">
            <form string="SOW Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Default Content">
                            <group>
                                <field name="default_intro"/>
                                <field name="default_scope"/>
                                <field name="default_assumptions"/>
                                <field name="default_exclusions"/>
                                <field name="acceptance_block_text"/>
                            </group>
                        </page>

                        <page string="Sections">
                            <field name="section_ids">
                                <list editable="bottom">
                                    <field name="sort_order"/>
                                    <field name="section_code"/>
                                    <field name="title"/>
                                    <field name="optional"/>
                                    <field name="editable"/>
                                    <field name="active"/>
                                </list>
                                <form string="SOW Template Section">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="sort_order"/>
                                                <field name="section_code"/>
                                                <field name="title"/>
                                            </group>
                                            <group>
                                                <field name="optional"/>
                                                <field name="editable"/>
                                                <field name="active"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="default_text"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gms_sow_template" model="ir.actions.act_window">
        <field name="name">SOW Templates</field>
        <field name="res_model">gms.sow.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gms_sow_template"
              name="SOW Templates"
              parent="menu_gms_templates"
              action="action_gms_sow_template"/>
</odoo>